/.svelte-kit
/build

# Demo artifacts, downloaded by scripts/fetch-demos.ts.
# Never committed: they are build output owned by another repo, they'd bloat
# history with a new binary blob on every version bump, and demos.manifest.json
# already records exactly which version belongs to any given commit.
/static/demos

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Generated by scripts/fetch-demos.ts from each artifact meta.json.
# Not committed: it is derived from demos.manifest.json plus the fetched
# artifacts, and every entry point (predev/prebuild/precheck) regenerates it.
/src/lib/demo/generated-manifest.ts
